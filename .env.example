MODEL_DIR=models
# Metadata only; serialized production artifacts remain local and ignored by Git.
PRODUCTION_MODEL_MANIFEST=production_model_manifest.json
# Optional base directory for local datasets and model artifacts when installed from PyPI.
# PROJECT_ROOT=.
DEFAULT_MODEL=direct_wqi5
API_HOST=0.0.0.0
API_PORT=8001
AUTO_PORT=false
DATASET_FILE=dataV1.csv
# Set true only when percentile/category endpoints must be ready at startup.
REQUIRE_DATASET_FOR_READINESS=false
MODEL_ARTIFACT_SIZE=50000
REQUEST_TIMEOUT_MS=10000

# CORS settings for WaterMirror frontend (comma-separated origins, or * for development)
CORS_ALLOW_ORIGINS=*
